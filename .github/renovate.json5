{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "ignoreDeps": [
     "open-telemetry/opentelemetry-swift-core"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/BuildAndTest\\.yml$/"],
      "matchStrings": ["image: (?<depName>swift):(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]+)"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "groupName": "all patch versions",
      "matchUpdateTypes": ["patch", "digest"],
      "schedule": ["before 8am every weekday"]
    },
    {
      "matchUpdateTypes": ["minor", "major"],
      "schedule": ["before 8am on Monday"]
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".github/workflows/BuildAndTest.yml"],
      "matchPackageNames": ["swift"],
      "separateMinorPatch": true
    },
    {
      "description": "Keep the Swift compatibility matrix on its selected minor versions",
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".github/workflows/BuildAndTest.yml"],
      "matchPackageNames": ["swift"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false
    }
  ],
  "labels": [
    "dependencies"
  ]
}
