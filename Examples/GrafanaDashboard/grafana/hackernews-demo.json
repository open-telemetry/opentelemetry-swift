          "queryType": "traceql",
          "tableType": "spans",
          "limit": 200,
          "spss": 100,
          "query": "{resource.service.name=\"$service\" && (span.session.id =~ \"${session:regex}\" || \"${session:regex}\" = \".*\")} | select(name, span.session.id, instrumentation:name)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
