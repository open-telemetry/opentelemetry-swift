              "left": {
                "matcher": {
                  "id": "byName",
                  "options": "Start time"
                }
              },
              "operator": "+",
              "right": {
                "fixed": "0"
              }
            }
          },
          "filter": {
            "id": "byRefId",
            "options": "A"
          }
        },
