{
  "uid": "hackernews-demo",
  "title": "HackerNewsDemo",
  "tags": [
    "opentelemetry-swift"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "service_name",
          "stream": "",
          "type": 1,
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "HackerNewsDemo",
          "value": "HackerNewsDemo"
        },
        "includeAll": false,
        "multi": false
      },
      {
        "name": "session",
        "label": "Session",
        "type": "query",
        "datasource": {
          "type": "tempo",
          "uid": "tempo"
        },
        "query": {
          "type": 1,
          "label": "session.id",
          "refId": "TempoDatasourceVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allowCustomValue": true
      },
      {
        "name": "trace",
        "type": "textbox",
        "hide": 2,
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "span",
        "type": "textbox",
        "hide": 2,
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "event",
        "type": "textbox",
        "hide": 2,
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
