// DO **NOT** EDIT. This file is automatically generated.

import Foundation

extension FederatedSemanticConventions {
  /// The span names the federated registry defines, so instrumentations don't repeat the strings.
  public enum SpanName: String, CaseIterable {
{% for group in ctx | selectattr("kind", "equalto", "span") | sort(attribute="name") %}

    /// {{ group.brief | trim | replace("\n", " ") }}
    case {{ group.name | replace(".", "_") | camel_case }} = "{{ group.name }}"
{% endfor %}
  }

  /// The metric names the federated registry defines.
  public enum MetricName: String, CaseIterable {
{% for group in ctx | selectattr("kind", "equalto", "metric") | sort(attribute="name") %}

    /// {{ group.brief | trim | replace("\n", " ") }}
    case {{ group.name | replace(".", "_") | camel_case }} = "{{ group.name }}"
{% endfor %}
  }
}
